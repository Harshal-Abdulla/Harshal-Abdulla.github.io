import { ImageResponse } from "next/og";

export const alt =
  "Harshal Abdulla. I build systems that are not allowed to get money or messages wrong.";
export const size = { width: 1200, height: 630 };
export const contentType = "image/png";
export const dynamic = "force-static";

/**
 * One Open Graph image for the whole site, rendered to a PNG at build time and
 * written into `out/`. Nothing fetches it at runtime.
 *
 * It deliberately uses the default bundled font rather than loading Inter. A
 * custom font here would be one more thing that can break a build in two years
 * for an image almost nobody looks at closely.
 */
export default function Image() {
  return new ImageResponse(
    (
      <div
        style={{
          width: "100%",
          height: "100%",
          display: "flex",
          flexDirection: "column",
          justifyContent: "space-between",
          backgroundColor: "#0B0E14",
          padding: "72px",
        }}
      >
        <div style={{ display: "flex", fontSize: 26, color: "#F0A538" }}>
          Harshal Abdulla
        </div>
        <div
          style={{
            display: "flex",
            fontSize: 58,
            color: "#F0EEE9",
            lineHeight: 1.15,
            letterSpacing: "-0.03em",
            maxWidth: "960px",
          }}
        >
          I build systems that are not allowed to get money or messages wrong.
        </div>
        <div style={{ display: "flex", fontSize: 26, color: "#A2A9B8" }}>
          Associate software engineer, Ireland
        </div>
      </div>
    ),
    size,
  );
}
